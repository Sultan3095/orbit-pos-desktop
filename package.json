{
  "name": "orbit-pos-desktop",
  "productName": "Orbit POS",
  "version": "1.0.0",
  "description": "Orbit POS desktop point of sale (standalone, offline, Arabic/English)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.js && node test/i18n.test.js",
    "pack:win": "electron-packager . \"Orbit POS\" --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --ignore=\"^/(dist|test|shots|\\.github)\"",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.orbit.pos",
    "productName": "Orbit POS",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
